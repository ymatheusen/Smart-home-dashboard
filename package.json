{
  "name": "mijn-woning",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:standalone": "tsc --noEmit && vite build --config vite.standalone.config.ts",
    "test": "playwright test",
    "test:production": "npm run build && node scripts/verify-production.mjs",
    "deploy:pages": "npm run build && npm run build:standalone && node scripts/publish-pages.mjs",
    "test:pwa": "npm run build && node scripts/verify-pwa.mjs",
    "android:sync": "tsc --noEmit && vite build --mode android && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "test:hue": "node --experimental-strip-types --test unit/hue-model.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
